{
  "name": "cypress-parallel-fast",
  "version": "1.0.3",
  "description": "Parallelize Cypress test cases within and across spec files using a dynamic task queue — faster than file-level splitting because individual it() blocks are distributed across workers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "cypress-parallel-fast": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "cypress",
    "parallel",
    "test-splitting",
    "cypress-parallel",
    "ci",
    "speed",
    "grep"
  ],
  "author": "camppp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camppp/cypress-parallel-fast.git"
  },
  "bugs": {
    "url": "https://github.com/camppp/cypress-parallel-fast/issues"
  },
  "homepage": "https://github.com/camppp/cypress-parallel-fast#readme",
  "dependencies": {
    "commander": "^11.1.0",
    "fast-glob": "^3.3.2",
    "junit-report-merger": "^9.0.3",
    "p-limit": "^3.1.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^20.10.0",
    "cypress": "^15.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "cypress": ">=10.0.0"
  }
}
